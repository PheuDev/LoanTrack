# Copier ce fichier en .env (PowerShell : copy .env.example .env)
# Connexion MySQL (WAMP) — à adapter si l'utilisateur ou le mot de passe diffèrent.
# Pour créer la base et l'utilisateur loantrack : scripts/db-init-mysql.ps1
# (les installations existantes sur la base `flexiloan` continuent de fonctionner :
#  gardez simplement votre DATABASE_URL actuelle pointant vers flexiloan)
DATABASE_URL=mysql://loantrack:loantrack@localhost:3306/loantrack
PORT=3001
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h
NODE_ENV=development
